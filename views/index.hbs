<div class="container my-5 flex-grow-1">
    <div class="row g-4 justify-content-center">
        
        <div class="col-lg-10">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-dark text-white fw-bold py-3 d-flex justify-content-between align-items-center">
                    <span><i class="bi bi-speedometer2 me-2"></i>Student Data Dashboard</span>
                    <span class="badge bg-primary fs-6 p-2" id="avg-score-badge">Rata-rata Nilai: 0</span>
                </div>
                <div class="card-body p-4">
                    
                    <div class="row mb-4">
                        <div class="col-md-6">
                            <label for="searchStudent" class="form-label fw-semibold text-secondary">Cari Nama Siswa</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-secondary"><i class="bi bi-search"></i></span>
                                <input type="text" class="form-control py-2" id="searchStudent" placeholder="Ketik nama siswa di sini...">
                            </div>
                        </div>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th scope="col" style="width: 10%">No</th>
                                    <th scope="col" style="width: 45%">Nama Siswa</th>
                                    <th scope="col" style="width: 25%">Kelas</th>
                                    <th scope="col" style="width: 20%">Nilai (Score)</th>
                                </tr>
                            </thead>
                            <tbody id="student-list">
                                </tbody>
                        </table>
                    </div>

                </div>
            </div>
        </div>

    </div>
</div>

<script src="/js/script.js"></script>